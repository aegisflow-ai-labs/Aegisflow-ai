{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "const": "SYNTHETIC_PROCUREMENT_REVIEW",
      "default": "SYNTHETIC_PROCUREMENT_REVIEW",
      "title": "Kind",
      "type": "string"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Case Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "order_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Order Id",
      "type": "string"
    },
    "source_checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Checksum",
      "type": "string"
    },
    "destination": {
      "const": "synthetic://procurement-review",
      "default": "synthetic://procurement-review",
      "title": "Destination",
      "type": "string"
    },
    "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.:-]+$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "policy_version": {
      "const": "supply-action-v1",
      "default": "supply-action-v1",
      "title": "Policy Version",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "tenant_id",
    "order_id",
    "source_checksum",
    "message",
    "evidence_refs"
  ],
  "title": "ActionPayload",
  "type": "object"
}
