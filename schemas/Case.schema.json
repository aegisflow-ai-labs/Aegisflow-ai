{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "code": {
          "enum": [
            "DELIVERY_DELAY",
            "SLA_BREACH",
            "INVENTORY",
            "PROCEDURE"
          ],
          "title": "Code",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "value",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "evidence_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Evidence Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "source_uri": {
          "title": "Source Uri",
          "type": "string"
        },
        "source_version": {
          "title": "Source Version",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "checksum": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Checksum",
          "type": "string"
        },
        "snapshot": {
          "additionalProperties": true,
          "title": "Snapshot",
          "type": "object"
        }
      },
      "required": [
        "evidence_id",
        "tenant_id",
        "case_id",
        "source_uri",
        "source_version",
        "captured_at",
        "checksum",
        "snapshot"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Task Id",
          "type": "string"
        },
        "case_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Case Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Tenant Id",
          "type": "string"
        },
        "role_id": {
          "const": "A21",
          "title": "Role Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "NEEDS_EVIDENCE"
          ],
          "title": "Status",
          "type": "string"
        },
        "policy_version": {
          "const": "elapsed-seconds-v1",
          "default": "elapsed-seconds-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "allowed_tools": {
          "default": [
            "read_synthetic_snapshot"
          ],
          "items": {
            "const": "read_synthetic_snapshot",
            "type": "string"
          },
          "title": "Allowed Tools",
          "type": "array"
        },
        "max_source_bytes": {
          "const": 1000000,
          "default": 1000000,
          "title": "Max Source Bytes",
          "type": "integer"
        }
      },
      "required": [
        "task_id",
        "case_id",
        "tenant_id",
        "role_id",
        "status"
      ],
      "title": "Task",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Case Id",
      "type": "string"
    },
    "tenant_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "subject_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Subject Id",
      "type": "string"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Trace Id",
      "type": "string"
    },
    "source_version": {
      "title": "Source Version",
      "type": "string"
    },
    "source_checksum": {
      "title": "Source Checksum",
      "type": "string"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "NEEDS_EVIDENCE"
      ],
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/Task"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "uncertainty": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainty",
      "type": "array"
    },
    "active_roles": {
      "default": [
        "A21"
      ],
      "items": {
        "const": "A21",
        "type": "string"
      },
      "title": "Active Roles",
      "type": "array"
    },
    "model_calls": {
      "const": 0,
      "default": 0,
      "title": "Model Calls",
      "type": "integer"
    }
  },
  "required": [
    "case_id",
    "tenant_id",
    "subject_id",
    "trace_id",
    "source_version",
    "source_checksum",
    "status",
    "created_at",
    "as_of",
    "task",
    "claims",
    "evidence",
    "uncertainty"
  ],
  "title": "Case",
  "type": "object"
}
